def safe_divide(a, b):
    """Avoid divide-by-zero issues."""
    return np.where(b != 0, a / b, np.nan)

# ==============================================================
# Calculate PCR and Retention with Correct Formulas (National Level)
# ==============================================================

# Current issue the retention value is weird for Droctoral specifcly 
def calculate_pcr_retention(df, categories, graph_dir):
    """
    Calculate PCR and Retention at the national level with correct multi-year formulas:
    
    PCR(year) = [sum of all comp(year+5) + comp(year+6) + comp(year+7)] / 
                [sum of all first(year-1) + first(year) + first(year+1)]
    
    Retention(year) = [sum of all total(year) + comp(year) - first(year)] / 
                      [sum of all total(year-1)]
    """
    
    # Normalize column names
    df.columns = df.columns.str.lower()
    
    results = []
    
    for label, info in categories.items():
        comp_col = info["comp"].lower()
        first_col = info["first"].lower()
        total_col = info["total"].lower()
        awlevel_filter = info.get("awlevel", None)
        
        # Check presence
        if comp_col not in df.columns or first_col not in df.columns or total_col not in df.columns:
            print(f"Skipping {label}: missing data columns.")
            continue
        
        temp = df.copy()
        
        # Apply awlevel filter if applicable
        if awlevel_filter and "awlevel" in temp.columns:
            temp = temp[temp["awlevel"].isin(awlevel_filter)]

        # ADD THIS CHECK - Skip if filtering resulted in no data
        if temp.empty:
            print(f"Skipping {label}: no data after applying awlevel filter.")
            continue

        
        # Group by year, summing across ALL institutions
        national_totals = temp.groupby("year", as_index=False).agg({
            comp_col: "sum",
            first_col: "sum",
            total_col: "sum"
        })
        
        # Sort by year
        national_totals = national_totals.sort_values("year")
        
        # Calculate PCR and Retention at national level
        pcr_data = []
        
        for idx, row in national_totals.iterrows():
            year = row["year"]
            
            # PCR: Get completions for year+5, year+6, year+7
            comp_5 = national_totals[national_totals["year"] == year + 5][comp_col].sum()
            comp_6 = national_totals[national_totals["year"] == year + 6][comp_col].sum()
            comp_7 = national_totals[national_totals["year"] == year + 7][comp_col].sum()
            total_comp = comp_5 + comp_6 + comp_7
            total_year = national_totals[national_totals["year"] == year][comp_col].sum()
            
            # PCR: Get first-years for year-1, year, year+1
            first_m1 = national_totals[national_totals["year"] == year - 1][first_col].sum()
            first_0 = national_totals[national_totals["year"] == year][first_col].sum()
            first_p1 = national_totals[national_totals["year"] == year + 1][first_col].sum()
            total_first = first_m1 + first_0 + first_p1
            
            
            
            # Calculate PCR
            pcr = total_comp / total_first if total_first > 0 else np.nan
            
            # Retention: [total(year) + comp(year) - first(year)] / total(year-1)
            total_current = row[total_col]
            comp_current = row[comp_col]
            first_current = row[first_col]
            
            total_prev = national_totals[national_totals["year"] == year - 1][total_col].sum()
            
            if total_prev > 0:
                retention = (total_current + comp_current - first_current) / total_prev
            else:
                retention = np.nan
            
            pcr_data.append({
                "year": year,
                "pcr": pcr,
                "retention": retention,
                "category": label,
                "total_completions": total_year,
                "total_first_years": first_0,
                "total_enrolled": total_current
            })
        
        if pcr_data:
            results.append(pd.DataFrame(pcr_data))
    
    # Combine all results
    if not results:
        print("No results to combine.")
        return None
    
    final_df = pd.concat(results, ignore_index=True)
    
    # Save national-level results
    summary_path = os.path.join(graph_dir, "PCR_Retention_National.xlsx")
    final_df.to_excel(summary_path, index=False)
    print(f"National-level results saved: {summary_path}")
    
    return final_df



