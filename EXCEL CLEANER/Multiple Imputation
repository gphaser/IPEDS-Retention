from sklearn.experimental import enable_iterative_imputer  # noqa
from sklearn.impute import IterativeImputer
import pandas as pd
import numpy as np

# Example dataset
df = pd.DataFrame({
    'PhD': [1, 1, 1, 1, np.nan, 2, 1, 3, np.nan, 1, 1, 1, 3, 6, 6, 2, 1, 1, 2, 2, 6, 4, 3, 2],
    'First year': [2, 5, 0, 4, 2, 0, 0, 8, 9, 4, 3, 3, 3, 2, 6, 2, 3, 4, 4, 3, 2, 6, 3, 5]
})

# Define the imputer
imputer = IterativeImputer(random_state=0, max_iter=10)

# Fit and transform
imputed = imputer.fit_transform(df)
df_imputed = pd.DataFrame(np.round(imputed).astype(int), columns=df.columns)

print(df_imputed)


