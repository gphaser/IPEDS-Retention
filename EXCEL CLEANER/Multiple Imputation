def calculate_pcr(df, index):
    """
    Calculate PCR for a given index n.
    Returns PCR value or None if data is incomplete.
    """
    # Check if all required indices exist
    phd_indices = [index + 5, index + 6, index + 7]
    first_year_indices = [index - 1, index, index + 1]
    
    # Check bounds
