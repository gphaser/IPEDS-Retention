        ax.plot(cat_data["year"], cat_data["retention"], 
               color='tab:orange', marker='s', linewidth=2, markersize=6,
               label='Retention')
        
        # Add values above Retention points
        for idx, row in cat_data.iterrows():
            if not pd.isna(row["retention"]):
                ax.text(row["year"], row["retention"] + 0.01, f'{row["retention"]:.2%}',
                       ha='center', va='bottom', fontsize=9, color='tab:orange',
                       fontweight='bold')
        # Labels and formatting
        ax.set_xlabel('Year', fontsize=12)
        ax.set_ylabel('Rate', fontsize=12)
        ax.set_title(f'PCR and Retention Rates: {category}', 
                    fontsize=14, fontweight='bold', pad=20)
        ax.grid(True, alpha=0.3)
        ax.legend(loc='best', fontsize=10)
        
        # Format x-axis to show years clearly
        all_years = sorted(cat_data["year"].unique())
        ax.set_xticks(all_years)
        ax.set_xticklabels(all_years, rotation=45)
        
        # Set y-axis to percentage format if values are between 0 and 1
        if cat_data["pcr"].max() <= 1 and cat_data["retention"].max() <= 1:
            ax.yaxis.set_major_formatter(plt.FuncFormatter(lambda y, _: '{:.0%}'.format(y)))
        
        # Adjust layout to prevent label cutoff
        plt.tight_layout()
        
        # Save figure
        safe_category = category.replace(" ", "_").replace("/", "_")
        filepath = os.path.join(graph_dir, f"PCR_Retention_{safe_category}.png")
        plt.savefig(filepath, dpi=300, bbox_inches='tight')
        plt.close()
        
        print(f"Graph saved: {filepath}")
    
    print(f"\nAll graphs saved to: {graph_dir}")

