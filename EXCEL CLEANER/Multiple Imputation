# New code to work on the data file

import numpy as np
import pandas as pd
from sklearn.experimental import enable_iterative_imputer  # noqa
from sklearn.impute import IterativeImputer
import matplotlib.pyplot as plt
import os

# ============================================================
# STEP 0: Load your Excel file
# ============================================================
file_path = "/Users/co25936/Desktop/PER/IPEDS/complete_with_offsets_and_PA_noIPEDS_noAvg.xlsx"

# Read Excel
df = pd.read_excel(file_path)

# Display columns to verify names
print("Columns in file:\n", df.columns.tolist())

# Adjust these names if your Excel uses slightly different column headers
phd_col = "CTOTALT"
first_year_col = "first"

# Confirm the data subset
df_subset = df[[phd_col, first_year_col]].copy()
print("\nOriginal data (first few rows):")
print(df_subset.head())
print(f"\nMissing values in '{phd_col}': {df_subset[phd_col].isna().sum()}")
print(f"Missing values in '{first_year_col}': {df_subset[first_year_col].isna().sum()}")

# ============================================================
# STEP 1: Perform MICE Imputation
# ============================================================
print("\n" + "="*60)
print("PERFORMING MICE IMPUTATION")
print("="*60)

mice_imputer = IterativeImputer(
    max_iter=10,
    random_state=42,
    min_value=0
)

imputed_data = mice_imputer.fit_transform(df_subset)
df_imputed = pd.DataFrame(imputed_data, columns=[phd_col, first_year_col])

# ============================================================
# STEP 2: Round to Whole Numbers
# ============================================================
df_imputed[phd_col] = np.round(df_imputed[phd_col]).astype(int)
df_imputed[first_year_col] = np.round(df_imputed[first_year_col]).astype(int)

# ============================================================
# STEP 3: PCR Calculation
# ============================================================
def calculate_pcr(df, index):
    phd_indices = [index + 5, index + 6, index + 7]
    first_year_indices = [index - 1, index, index + 1]
    if (min(first_year_indices) < 0 or max(phd_indices) >= len(df)):
        return None
    phd_sum = df.loc[phd_indices, phd_col].sum()
    first_year_sum = df.loc[first_year_indices, first_year_col].sum()
    if first_year_sum == 0:
        return None
    return phd_sum / first_year_sum

pcr_results = []
for n in range(len(df_imputed)):
    pcr = calculate_pcr(df_imputed, n)
    if pcr is not None:
        pcr_results.append({
            'index_n': n,
            'PhD_sum': df_imputed.loc[[n+5, n+6, n+7], phd_col].sum(),
            'First_year_sum': df_imputed.loc[[n-1, n, n+1], first_year_col].sum(),
            'PCR': pcr
        })

pcr_df = pd.DataFrame(pcr_results)

# ============================================================
# STEP 4: Visualization
# ============================================================
fig, axes = plt.subplots(2, 2, figsize=(12, 10))

axes[0, 0].plot(df_subset.index, df_subset[phd_col], 'o-', label='Original', markersize=8)
axes[0, 0].plot(df_imputed.index, df_imputed[phd_col], 's--', label='Imputed', alpha=0.7, markersize=6)
axes[0, 0].legend()
axes[0, 0].set_title('PhD Values: Original vs Imputed')

axes[0, 1].plot(df_imputed.index, df_imputed[first_year_col], 'o-', color='green', markersize=8)
axes[0, 1].set_title('First Year Student Counts')

axes[1, 0].plot(pcr_df['index_n'], pcr_df['PCR'], 'o-', color='purple', markersize=8)
axes[1, 0].axhline(y=pcr_df['PCR'].mean(), color='red', linestyle='--', label=f'Mean = {pcr_df["PCR"].mean():.3f}')
axes[1, 0].legend()
axes[1, 0].set_title('PhD Completion Rate (PCR) by Index')

axes[1, 1].hist(pcr_df['PCR'], bins=10, color='skyblue', edgecolor='black', alpha=0.7)
axes[1, 1].axvline(x=pcr_df['PCR'].mean(), color='red', linestyle='--', linewidth=2, label=f'Mean = {pcr_df["PCR"].mean():.3f}')
axes[1, 1].legend()
axes[1, 1].set_title('Distribution of PCR Values')

plt.tight_layout()

# Save visualization
output_dir = os.path.dirname(file_path)
plot_path = os.path.join(output_dir, "mice_pcr_analysis.png")
plt.savefig(plot_path, dpi=300, bbox_inches='tight')
plt.show()
print(f"\n✓ Visualization saved as {plot_path}")

# ============================================================
# STEP 5: Export Results
# ============================================================
output_df = df_imputed.copy()
output_df[f'{phd_col}_original'] = df_subset[phd_col]
output_df[f'{phd_col}_imputed'] = df_imputed[phd_col]
output_df['was_imputed'] = df_subset[phd_col].isna()

output_file = os.path.join(output_dir, "mice_imputation_results.xlsx")
with pd.ExcelWriter(output_file, engine='openpyxl') as writer:
    output_df.to_excel(writer, sheet_name='Imputed_Data', index=True)
    pcr_df.to_excel(writer, sheet_name='PCR_Results', index=False)

print(f"✓ Results saved to '{output_file}'")
print("\nDone!")
